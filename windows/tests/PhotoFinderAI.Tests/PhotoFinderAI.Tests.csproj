<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests the helper's protocol, which is plain C#: runs anywhere, including CI with no NPU.
       Protocol.cs and Server.cs are compiled in directly rather than referencing the packaged exe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\PhotoFinderAI\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\..\src\PhotoFinderAI\Server.cs" Link="Server.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
