<Window x:Class="PhotoFinder.Views.CheckSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check System" Width="660" Height="460" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Text="Checking…" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AgainButton" Content="Check _Again" MinWidth="90" Padding="10,3" Click="CheckAgain_Click" />
            <Button Content="_Copy to Clipboard" MinWidth="90" Padding="10,3" Margin="8,0,0,0" Click="Copy_Click" />
            <Button Content="_Report a Bug…" MinWidth="90" Padding="10,3" Margin="8,0,0,0" Click="ReportBug_Click" />
            <Button Content="Close" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
        </StackPanel>
        <!-- One line per check, each read whole as the item's name (Item.ToString). -->
        <ListBox x:Name="ChecksList" Margin="0,10,0,0" AutomationProperties.Name="Checks"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Line}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
