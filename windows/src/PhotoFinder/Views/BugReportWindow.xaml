<Window x:Class="PhotoFinder.Views.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a Bug" Width="640" Height="720" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Help > Report a Bug… (#138), as on the Mac (#137): the form, then what happened to it. -->
    <Grid Margin="14">
        <DockPanel x:Name="FormPanel">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <!-- Not the default button: Enter in a field mustn't send a report half written. -->
                <Button x:Name="SendButton" Content="_Send" MinWidth="90" Padding="10,3" Click="Send_Click" />
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="NoKeyText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Kind" Margin="0,0,0,3" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="BugKind" Content="_Bug" GroupName="Kind" IsChecked="True" Margin="0,0,16,0" Checked="Kind_Checked"
                                     AutomationProperties.Name="Kind: Bug" />
                        <RadioButton x:Name="SuggestionKind" Content="Su_ggestion" GroupName="Kind" Checked="Kind_Checked"
                                     AutomationProperties.Name="Kind: Suggestion" />
                    </StackPanel>
                    <Label Content="_Title:" Target="{Binding ElementName=TitleBox}" Padding="0,0,0,3" />
                    <!-- The relay keeps 200 characters of a title, and "[Windows] " comes first. -->
                    <TextBox x:Name="TitleBox" MaxLength="180" Margin="0,0,0,8" TextChanged="Field_Changed" />
                    <StackPanel x:Name="BugFields">
                        <Label Content="What _happened:" Target="{Binding ElementName=HappenedBox}" Padding="0,0,0,3" />
                        <TextBox x:Name="HappenedBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,8" TextChanged="Field_Changed" />
                        <Label Content="What you _expected:" Target="{Binding ElementName=ExpectedBox}" Padding="0,0,0,3" />
                        <TextBox x:Name="ExpectedBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" Margin="0,0,0,8" TextChanged="Field_Changed" />
                        <Label Content="Ste_ps:" Target="{Binding ElementName=StepsBox}" Padding="0,0,0,3" />
                        <TextBox x:Name="StepsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,8" TextChanged="Field_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="SuggestionFields" Visibility="Collapsed">
                        <Label Content="_Your suggestion:" Target="{Binding ElementName=SuggestionBox}" Padding="0,0,0,3" />
                        <TextBox x:Name="SuggestionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,0,0,8" TextChanged="Field_Changed" />
                    </StackPanel>
                    <Label Content="_Contact (optional):" Target="{Binding ElementName=ContactBox}" Padding="0,0,0,3" />
                    <TextBox x:Name="ContactBox" Margin="0,0,0,3" TextChanged="Field_Changed" />
                    <!-- Said with the field (its help text) as well as shown, so nobody types an address without hearing it. -->
                    <TextBlock x:Name="ContactNote" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <CheckBox x:Name="SystemCheckBox" Content="Include the system chec_k" IsChecked="True" Margin="0,0,0,4" Click="Field_Changed" />
                    <CheckBox x:Name="AttachmentsBox" IsChecked="True" Margin="0,0,0,8" Visibility="Collapsed" Click="Field_Changed" />
                    <Label Content="P_review of what will be sent:" Target="{Binding ElementName=PreviewBox}" Padding="0,0,0,3"
                           AutomationProperties.HeadingLevel="Level2" />
                    <TextBox x:Name="PreviewBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" FontFamily="Consolas"
                             MinHeight="160" MaxHeight="260" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Preview" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Filed. -->
        <StackPanel x:Name="FiledPanel" Visibility="Collapsed">
            <TextBlock x:Name="FiledHeading" FontSize="15" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="FiledText" Text="Thank you. It's public on GitHub, where you can follow it." TextWrapping="Wrap" Margin="0,8,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenIssueButton" Content="_Open Issue" MinWidth="90" Padding="10,3" Click="OpenIssue_Click" />
                <Button Content="Done" IsDefault="True" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" Click="Done_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Not sent: says so and waits, rather than opening the browser at once, which would take focus and cut the
             message off. -->
        <StackPanel x:Name="NotSentPanel" Visibility="Collapsed">
            <TextBlock x:Name="NotSentHeading" FontSize="15" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="NotSentText" TextWrapping="Wrap" Margin="0,8,0,12" />
            <!-- Only when the clipboard couldn't take it, so the report can still be copied. -->
            <StackPanel x:Name="ReportTextPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <Label Content="_Report:" Target="{Binding ElementName=ReportTextBox}" Padding="0,0,0,3" />
                <TextBox x:Name="ReportTextBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" FontFamily="Consolas"
                         MinHeight="160" MaxHeight="360" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenInBrowserButton" Content="Open in _Browser" IsDefault="True" MinWidth="110" Padding="10,3" Click="OpenInBrowser_Click" />
                <Button Content="Done" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" Click="Done_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
