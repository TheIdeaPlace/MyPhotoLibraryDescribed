<UserControl x:Class="PhotoFinder.Views.DescriptionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Description">
    <!-- View > Show Description (#50): the photo's description for everyone who reads the screen, with what's happening,
         the caption, and the actions that go with them. Access keys stay clear of the menu bar's (F, E, V, G, P, H) and
         Search (S): Description D, Describe Again A, Use as Caption C, Copy O, Edit Caption T. -->
    <Border Padding="12,10" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
        <Grid>
            <!-- A photo. -->
            <DockPanel x:Name="PhotoPart">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="StatusText" Margin="0,2,0,8" TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <Label Content="_Description:" Target="{Binding ElementName=DescriptionBox}" Padding="0,0,0,2" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="DescribeAgainButton" Content="Describe _Again" Padding="8,2" Margin="0,0,6,6" Click="DescribeAgain_Click" />
                        <Button x:Name="UseAsCaptionButton" Content="Use as _Caption" Padding="8,2" Margin="0,0,6,6" Click="UseAsCaption_Click" />
                        <Button x:Name="CopyButton" Content="C_opy" Padding="8,2" Margin="0,0,6,6" Click="Copy_Click" />
                    </WrapPanel>
                    <Separator Margin="0,4,0,8" />
                    <TextBlock Text="Caption" FontWeight="SemiBold" />
                    <TextBox x:Name="CaptionBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Caption" Margin="0,2,0,6" />
                    <Button Content="Edit Cap_tion…" HorizontalAlignment="Left" Padding="8,2" Click="EditCaption_Click" />
                </StackPanel>
                <!-- Enter saves; Shift+Enter starts a new line. -->
                <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                         MinHeight="80" PreviewKeyDown="DescriptionBox_PreviewKeyDown" LostKeyboardFocus="DescriptionBox_LostKeyboardFocus"
                         AutomationProperties.HelpText="Edit to correct the description. Enter saves it." />
            </DockPanel>
            <!-- Nothing to describe. Focusable, so F6 can land here and move on rather than skip or stick. -->
            <TextBlock x:Name="NothingText" Focusable="True" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Grid>
    </Border>
</UserControl>
