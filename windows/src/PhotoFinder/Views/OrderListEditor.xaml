<UserControl x:Class="PhotoFinder.Views.OrderListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Editor_PreviewKeyDown">
    <!-- One tab of View > Labels (#38): the items not shown, the ones shown in the order they're read, the actions, and
         a preview. The words come from the tab (OrderChoice). -->
    <DockPanel>
        <TextBlock x:Name="Explanation" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Label x:Name="PreviewLabel" Target="{Binding ElementName=PreviewBox}" Padding="0,0,0,3" />
            <TextBox x:Name="PreviewBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MinHeight="44" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <!-- Always enabled, so the Tab order never changes: each says when there's nothing it can do. -->
            <Button Content="_Add" Padding="10,3" Margin="0,0,6,6" Click="Add_Click" />
            <Button Content="_Remove" Padding="10,3" Margin="0,0,6,6" Click="Remove_Click" />
            <Button Content="Move _Up" Padding="10,3" Margin="0,0,6,6" Click="MoveUp_Click" />
            <Button Content="Move _Down" Padding="10,3" Margin="0,0,6,6" Click="MoveDown_Click" />
            <Button Content="Move to _Top" Padding="10,3" Margin="0,0,6,6" Click="MoveTop_Click" />
            <Button Content="Move to _Bottom" Padding="10,3" Margin="0,0,6,6" Click="MoveBottom_Click" />
            <Button Content="R_eset to Default" Padding="10,3" Margin="0,0,6,6" Click="Reset_Click" />
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Label x:Name="AvailableLabel" DockPanel.Dock="Top" Target="{Binding ElementName=AvailableList}" Padding="0,0,0,3" />
                <ListBox x:Name="AvailableList" MouseDoubleClick="AvailableList_MouseDoubleClick" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <Label x:Name="ShownLabel" DockPanel.Dock="Top" Target="{Binding ElementName=ShownList}" Padding="0,0,0,3" />
                <ListBox x:Name="ShownList" MouseDoubleClick="ShownList_MouseDoubleClick" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
