<Window x:Class="PhotoFinder.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get Info" Width="560" Height="680" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="14,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <Button Content="Done" IsCancel="True" HorizontalAlignment="Right" MinWidth="80" Padding="10,3" Click="Done_Click" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="14,10,14,10">
                <TextBlock x:Name="NameHeading" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />

                <TextBlock Text="General" Style="{StaticResource SectionHeading}" />
                <ListBox x:Name="GeneralList" Style="{StaticResource FieldList}" AutomationProperties.Name="General"
                         KeyDown="FieldList_KeyDown" />

                <TextBlock Text="Details" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="DetailsStatus" Text="Reading details…" Style="{StaticResource Note}" Margin="0,4,0,12" />
                <ListBox x:Name="DetailsList" Style="{StaticResource FieldList}" AutomationProperties.Name="Details"
                         Visibility="Collapsed" KeyDown="FieldList_KeyDown" />

                <StackPanel x:Name="ContentsSection">
                    <TextBlock Text="Image Contents" Style="{StaticResource SectionHeading}" />

                    <TextBlock x:Name="AIStatus" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel x:Name="DescribePanel" Orientation="Horizontal" Margin="0,6,0,0">
                        <Label Content="Description _type:" Target="{Binding ElementName=KindBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="KindBox" Width="130" DisplayMemberPath="Title" SelectedValuePath="Id" />
                        <Button x:Name="DescribeButton" Content="_Describe Image" Margin="8,0,0,0" Padding="10,3" Click="Describe_Click" />
                    </StackPanel>
                    <Label x:Name="DescriptionLabel" Content="Descr_iption:" Target="{Binding ElementName=DescriptionBox}"
                           Padding="0,8,0,2" Visibility="Collapsed" />
                    <TextBox x:Name="DescriptionBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto" Visibility="Collapsed" IsReadOnlyCaretVisible="True" />
                    <Button x:Name="UseAsCaptionButton" Content="_Use as Caption" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Padding="10,3" Visibility="Collapsed" Click="UseAsCaption_Click" />
                    <TextBlock Style="{StaticResource Note}"
                               Text="Describes the photo with Windows' AI on this PC's NPU. The photo isn't sent anywhere." />

                    <Button x:Name="ReadTextButton" Content="_Read Text in Image" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="10,3"
                            Click="ReadText_Click" />
                    <TextBlock x:Name="OcrStatus" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                    <Label x:Name="OcrLabel" Content="Text in i_mage:" Target="{Binding ElementName=OcrBox}" Padding="0,8,0,2" Visibility="Collapsed" />
                    <TextBox x:Name="OcrBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" Visibility="Collapsed" IsReadOnlyCaretVisible="True" />
                    <TextBlock Style="{StaticResource Note}" Text="Reads any text in the photo with Windows' built-in text recognition." />

                    <!-- Follow-up questions (#24), once there's a description to answer from. -->
                    <StackPanel x:Name="AskPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <Label Content="Follow-up _question:" Target="{Binding ElementName=QuestionBox}" Padding="0,0,0,2" />
                        <DockPanel>
                            <Button x:Name="AskButton" Content="_Ask" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" Click="Ask_Click" />
                            <TextBox x:Name="QuestionBox" KeyDown="QuestionBox_KeyDown" />
                        </DockPanel>
                        <TextBlock x:Name="AskStatus" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        <Label x:Name="AnswersLabel" Content="Ans_wers:" Target="{Binding ElementName=AnswersBox}" Padding="0,8,0,2" Visibility="Collapsed" />
                        <TextBox x:Name="AnswersBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto" Visibility="Collapsed" IsReadOnlyCaretVisible="True" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Answers come from the description and any text read from the photo, not from looking at the photo again. Windows' text model answers on this PC." />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
