<Window x:Class="PhotoFinder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PhotoFinder.Views"
        xmlns:local="clr-namespace:PhotoFinder"
        xmlns:m="clr-namespace:PhotoFinder.Models"
        Title="{x:Static local:AppInfo.Name}" Width="1200" Height="760" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <v:TextVisibilityConverter x:Key="TextVisibility" />
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type m:FileRow}">
            <StackPanel Orientation="Horizontal" DataContextChanged="NameCell_DataContextChanged" Loaded="NameCell_Loaded"
                        AutomationProperties.Name="{Binding Name}">
                <Grid Width="24" Height="24" Margin="0,1,6,1">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Grid>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Not in the Tab or Ctrl+Tab order: menu bars are reached with Alt or F10, as in every Windows app.
             TabNavigation="None" is what does it (IsTabStop="False" is already the Menu's default; Menu sets
             ControlTabNavigation="Once" itself). Never IsTabStop="False" on the menus themselves: WPF's arrow
             keys look for tab stops, so Right Arrow would stop moving between them. Every item is an AppMenuItem, so
             ones that can't be used now are still reached with the arrows and read as unavailable, not skipped. -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" IsTabStop="False" KeyboardNavigation.TabNavigation="None"
              KeyboardNavigation.ControlTabNavigation="None">
            <v:AppMenuItem Header="_File">
                <v:AppMenuItem Command="v:AppCommands.OpenItem" />
                <v:AppMenuItem Command="v:AppCommands.Preview" InputGestureText="Space" />
                <v:AppMenuItem Command="v:AppCommands.GetInfo" />
                <v:AppMenuItem Command="v:AppCommands.ShowInExplorer" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.Export" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.AddFolder" />
                <v:AppMenuItem Command="v:AppCommands.RemoveFolder" />
                <v:AppMenuItem Command="v:AppCommands.Refresh" />
                <Separator />
                <v:AppMenuItem Header="Rea_d-Only Mode" x:Name="ReadOnlyItem" IsCheckable="True" Click="ReadOnly_Click" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.Exit" />
            </v:AppMenuItem>
            <v:AppMenuItem Header="_Edit">
                <v:AppMenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                <v:AppMenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.Find" />
            </v:AppMenuItem>
            <v:AppMenuItem Header="_View" x:Name="ViewMenu" SubmenuOpened="ViewMenu_SubmenuOpened">
                <v:AppMenuItem x:Name="AsListItem" Command="v:AppCommands.AsList" IsCheckable="False" />
                <v:AppMenuItem x:Name="AsGalleryItem" Command="v:AppCommands.AsGallery" IsCheckable="False" />
                <Separator />
                <v:AppMenuItem x:Name="ShowDescriptionItem" Command="v:AppCommands.ShowDescription" IsCheckable="False" />
                <v:AppMenuItem Command="v:AppCommands.ChooseColumns" />
                <v:AppMenuItem Header="_Sort By" x:Name="SortMenu" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.ReadStatusBar" />
                <v:AppMenuItem Command="v:AppCommands.GoToStatusBar" />
            </v:AppMenuItem>
            <v:AppMenuItem Header="_Go">
                <v:AppMenuItem Command="v:AppCommands.EnclosingFolder" />
                <v:AppMenuItem Command="v:AppCommands.OpenSelected" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.AllPhotos" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.GoToDescription" />
            </v:AppMenuItem>
            <v:AppMenuItem Header="_Photo">
                <v:AppMenuItem Command="v:AppCommands.ToggleFavorite" />
                <v:AppMenuItem Command="v:AppCommands.EditCaption" />
                <v:AppMenuItem Header="_Rating">
                    <v:AppMenuItem Header="_No Rating" Command="v:AppCommands.Rate" CommandParameter="0" />
                    <v:AppMenuItem Header="_1 Star" Command="v:AppCommands.Rate" CommandParameter="1" />
                    <v:AppMenuItem Header="_2 Stars" Command="v:AppCommands.Rate" CommandParameter="2" />
                    <v:AppMenuItem Header="_3 Stars" Command="v:AppCommands.Rate" CommandParameter="3" />
                    <v:AppMenuItem Header="_4 Stars" Command="v:AppCommands.Rate" CommandParameter="4" />
                    <v:AppMenuItem Header="_5 Stars" Command="v:AppCommands.Rate" CommandParameter="5" />
                </v:AppMenuItem>
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.DescribePhoto" />
                <v:AppMenuItem Command="v:AppCommands.Redescribe" />
                <v:AppMenuItem Command="v:AppCommands.UseDescriptionAsCaption" />
                <v:AppMenuItem x:Name="AutoDescribeItem" Command="v:AppCommands.AutoDescribe" IsCheckable="True" />
                <v:AppMenuItem Header="Description T_ype" x:Name="KindMenu" />
                <v:AppMenuItem Header="Save Descriptions _in Photos" x:Name="SaveInPhotosItem" IsCheckable="True" Click="SaveInPhotos_Click" />
                <v:AppMenuItem x:Name="BackgroundDescribeItem" Command="v:AppCommands.DescribeInBackground" IsCheckable="True" />
                <v:AppMenuItem Command="v:AppCommands.StopBackground" />
            </v:AppMenuItem>
            <v:AppMenuItem Header="_Help">
                <v:AppMenuItem x:Name="UpdatesItem" Command="v:AppCommands.CheckForUpdates" />
                <v:AppMenuItem Command="v:AppCommands.ReportBug" />
                <v:AppMenuItem Command="v:AppCommands.CheckSystem" />
                <v:AppMenuItem Command="v:AppCommands.CheckAIDescription" />
                <v:AppMenuItem Command="v:AppCommands.OpenLogFolder" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.UserGuide" />
                <v:AppMenuItem Command="v:AppCommands.PrivacyPolicy" />
                <Separator />
                <v:AppMenuItem Command="v:AppCommands.About" />
            </v:AppMenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Label Content="_Search:" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center" Padding="0,0,6,0" />
                    <TextBox x:Name="SearchBox" Width="280" VerticalContentAlignment="Center" Padding="2"
                             AutomationProperties.Name="Search names, kinds, captions and dates"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                </StackPanel>
                <TextBlock x:Name="LocationHeading" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            </DockPanel>
        </Border>

        <!-- A real StatusBar, so JAWS (Insert+Page Down) and NVDA (Insert+End) can read it. It's also the last
             stop in the F6 loop, like QuickMail's: each section is its own focus stop, Left and Right move between
             them (wrapping), and Tab, F6 or Escape leave. Sections with nothing to say are hidden and skipped.
             No name, as in QuickMail, so NVDA's Insert+End doesn't start with "Status bar"; F6 announces it instead. -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Padding="6,2" AutomationProperties.Name=""
                   KeyboardNavigation.TabNavigation="None" KeyboardNavigation.DirectionalNavigation="Contained"
                   PreviewKeyDown="StatusBar_PreviewKeyDown">
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Focusable="False">
                <!-- No name: it's decorative (the sections say what's happening), and NVDA's Insert+End reads every
                     named child, even hidden ones, so it said "Working" when nothing was. -->
                <ProgressBar IsIndeterminate="True" Width="60" Height="10" Focusable="False" />
            </StatusBarItem>
            <StatusBarItem Focusable="False">
                <TextBlock x:Name="StatusBarText" Text="{Binding StatusText}" Focusable="True" />
            </StatusBarItem>
            <StatusBarItem x:Name="ActivityItem" Focusable="False"
                           Visibility="{Binding CurrentActivity, Converter={StaticResource TextVisibility}}">
                <TextBlock x:Name="ActivityText" Text="{Binding CurrentActivity}" Focusable="True" IsVisibleChanged="StatusSection_IsVisibleChanged" />
            </StatusBarItem>
            <StatusBarItem x:Name="BackgroundItem" Focusable="False"
                           Visibility="{Binding BackgroundProgress, Converter={StaticResource TextVisibility}}">
                <TextBlock x:Name="BackgroundText" Text="{Binding BackgroundProgress}" Focusable="True" IsVisibleChanged="StatusSection_IsVisibleChanged" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Sidebar" Grid.Column="0" ItemsSource="{Binding Sections}"
                      AutomationProperties.Name="Sidebar" BorderThickness="0"
                      SelectedItemChanged="Sidebar_SelectedItemChanged" PreviewKeyDown="Sidebar_PreviewKeyDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <!-- Not the count as a separate element: screen readers would read the sidebar as a list of numbers. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type m:SidebarItem}" ItemsSource="{Binding Children}">
                        <DockPanel MinWidth="150">
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,4,0" Text="{Binding Count, StringFormat=N0}"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:SourceKind.Section}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Title}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:SourceKind.Section}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Focusable="False"
                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

            <!-- The list or gallery, and View > Show Description's panel beside it (#50), resizable. -->
            <Grid Grid.Column="2" x:Name="ContentArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PanelColumn" Width="320" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <v:FileListView x:Name="FileList" ItemsSource="{Binding Rows}" SelectionMode="Extended"
                                    KeyboardNavigation.TabNavigation="Once"
                                    AutomationProperties.Name="{Binding Title}"
                                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                    VirtualizingPanel.ScrollUnit="Item" BorderThickness="0"
                                    SelectionChanged="FileList_SelectionChanged" PreviewKeyDown="FileList_PreviewKeyDown"
                                    MouseDoubleClick="FileList_MouseDoubleClick"
                                    PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseMove="FileList_PreviewMouseMove">
                        <v:FileListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </v:FileListView.ItemContainerStyle>
                        <v:FileListView.View>
                            <GridView x:Name="ListColumns" AllowsColumnReorder="False" />
                        </v:FileListView.View>
                        <v:FileListView.ContextMenu>
                            <ContextMenu>
                                <v:AppMenuItem Command="v:AppCommands.OpenItem" />
                                <v:AppMenuItem Command="v:AppCommands.Preview" InputGestureText="Space" />
                                <v:AppMenuItem Command="v:AppCommands.GetInfo" />
                                <v:AppMenuItem Command="v:AppCommands.EditCaption" />
                                <v:AppMenuItem Command="v:AppCommands.ShowInExplorer" />
                                <Separator />
                                <v:AppMenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                                <v:AppMenuItem Command="v:AppCommands.Export" />
                                <Separator />
                                <v:AppMenuItem Command="v:AppCommands.ToggleFavorite" />
                                <v:AppMenuItem Command="v:AppCommands.DescribePhoto" />
                                <v:AppMenuItem Command="v:AppCommands.Redescribe" />
                                <v:AppMenuItem Command="v:AppCommands.UseDescriptionAsCaption" />
                            </ContextMenu>
                        </v:FileListView.ContextMenu>
                    </v:FileListView>

                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Visibility="Collapsed" />

                    <!-- In Tab order: the photo, then its name, details, caption and description, then Previous, the
                         position and Next. -->
                    <Grid x:Name="GalleryPanel" Visibility="Collapsed" PreviewKeyDown="Gallery_PreviewKeyDown">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- One focusable image named with just the file name, so arrowing says which photo and its
                             description follows, and a screen reader's image description (JAWS Picture Smart, NVDA's
                             describers) looks at the full-size picture. -->
                        <v:GalleryImage x:Name="GalleryImage" Margin="16" Focusable="True" FocusVisualStyle="{x:Null}"
                                        MouseDown="GalleryImage_MouseDown" />
                        <Border Grid.Row="1" Padding="12,8" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBox x:Name="GalleryName" FontWeight="SemiBold" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             AutomationProperties.Name="Name" />
                                    <TextBox x:Name="GalleryDetails" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" AutomationProperties.Name="Details" />
                                    <TextBox x:Name="GalleryCaption" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" AutomationProperties.Name="Caption" />
                                    <TextBox x:Name="GalleryDescription" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Description" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PreviousButton" Content="◀ Previous" Padding="10,3" Click="PreviousButton_Click"
                                            AutomationProperties.Name="Previous" />
                                    <TextBox x:Name="GalleryPositionText" Margin="10,0" VerticalAlignment="Center" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" AutomationProperties.Name="Position" />
                                    <Button x:Name="NextButton" Content="Next ▶" Padding="10,3" Click="NextButton_Click"
                                            AutomationProperties.Name="Next" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Focusable="False"
                              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" DragCompleted="PanelSplitter_DragCompleted" />
                <v:DescriptionPanel x:Name="DescriptionPanel" Grid.Column="2" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
