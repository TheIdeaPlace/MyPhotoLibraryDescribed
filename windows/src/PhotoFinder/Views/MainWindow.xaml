<Window x:Class="PhotoFinder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PhotoFinder.Views"
        xmlns:m="clr-namespace:PhotoFinder.Models"
        Title="Photo Finder" Width="1200" Height="760" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type m:FileRow}">
            <StackPanel Orientation="Horizontal" DataContextChanged="NameCell_DataContextChanged" Loaded="NameCell_Loaded"
                        AutomationProperties.Name="{Binding Name}">
                <Grid Width="24" Height="24" Margin="0,1,6,1">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Grid>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Not in the Tab or Ctrl+Tab order: menu bars are reached with Alt or F10, as in every Windows app.
             TabNavigation="None" is what does it (IsTabStop="False" is already the Menu's default; Menu sets
             ControlTabNavigation="Once" itself). Never IsTabStop="False" on the menus themselves: WPF's arrow
             keys look for tab stops, so Right Arrow would stop moving between them. -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" IsTabStop="False" KeyboardNavigation.TabNavigation="None"
              KeyboardNavigation.ControlTabNavigation="None">
            <MenuItem Header="_File">
                <MenuItem Command="v:AppCommands.OpenItem" />
                <MenuItem Command="v:AppCommands.Preview" InputGestureText="Space" />
                <MenuItem Command="v:AppCommands.GetInfo" />
                <MenuItem Command="v:AppCommands.ShowInExplorer" />
                <Separator />
                <MenuItem Command="v:AppCommands.Export" />
                <Separator />
                <MenuItem Command="v:AppCommands.AddFolder" />
                <MenuItem Command="v:AppCommands.RemoveFolder" />
                <MenuItem Command="v:AppCommands.Refresh" />
                <Separator />
                <MenuItem Command="v:AppCommands.Exit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem Command="v:AppCommands.Find" />
            </MenuItem>
            <MenuItem Header="_View" x:Name="ViewMenu" SubmenuOpened="ViewMenu_SubmenuOpened">
                <MenuItem x:Name="AsListItem" Command="v:AppCommands.AsList" IsCheckable="False" />
                <MenuItem x:Name="AsGalleryItem" Command="v:AppCommands.AsGallery" IsCheckable="False" />
                <Separator />
                <MenuItem Header="_Columns" x:Name="ColumnsMenu" />
                <MenuItem Header="_Sort By" x:Name="SortMenu" />
            </MenuItem>
            <MenuItem Header="_Go">
                <MenuItem Command="v:AppCommands.EnclosingFolder" />
                <MenuItem Command="v:AppCommands.OpenSelected" />
                <Separator />
                <MenuItem Command="v:AppCommands.AllPhotos" />
            </MenuItem>
            <MenuItem Header="_Photo">
                <MenuItem Command="v:AppCommands.ToggleFavorite" />
                <MenuItem Command="v:AppCommands.EditCaption" />
                <MenuItem Header="_Rating">
                    <MenuItem Header="_No Rating" Command="v:AppCommands.Rate" CommandParameter="0" />
                    <MenuItem Header="_1 Star" Command="v:AppCommands.Rate" CommandParameter="1" />
                    <MenuItem Header="_2 Stars" Command="v:AppCommands.Rate" CommandParameter="2" />
                    <MenuItem Header="_3 Stars" Command="v:AppCommands.Rate" CommandParameter="3" />
                    <MenuItem Header="_4 Stars" Command="v:AppCommands.Rate" CommandParameter="4" />
                    <MenuItem Header="_5 Stars" Command="v:AppCommands.Rate" CommandParameter="5" />
                </MenuItem>
                <Separator />
                <MenuItem Command="v:AppCommands.DescribeImage" />
                <MenuItem x:Name="AutoDescribeItem" Command="v:AppCommands.AutoDescribe" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Command="v:AppCommands.About" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Label Content="_Search:" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center" Padding="0,0,6,0" />
                    <TextBox x:Name="SearchBox" Width="280" VerticalContentAlignment="Center" Padding="2"
                             AutomationProperties.Name="Search names, kinds, captions and dates"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                </StackPanel>
                <TextBlock x:Name="LocationHeading" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            </DockPanel>
        </Border>

        <!-- A real StatusBar, so JAWS (Insert+Page Down) and NVDA (Insert+End) can read it. -->
        <StatusBar DockPanel.Dock="Bottom" Padding="6,2">
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="60" Height="10" AutomationProperties.Name="Working" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="{Binding StatusBarText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Sidebar" Grid.Column="0" ItemsSource="{Binding Sections}"
                      AutomationProperties.Name="Sidebar" BorderThickness="0"
                      SelectedItemChanged="Sidebar_SelectedItemChanged" PreviewKeyDown="Sidebar_PreviewKeyDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <!-- Not the count as a separate element: screen readers would read the sidebar as a list of numbers. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type m:SidebarItem}" ItemsSource="{Binding Children}">
                        <DockPanel MinWidth="150">
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,4,0" Text="{Binding Count, StringFormat=N0}"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:SourceKind.Section}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Title}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:SourceKind.Section}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Focusable="False"
                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

            <Grid Grid.Column="2">
                <v:FileListView x:Name="FileList" ItemsSource="{Binding Rows}" SelectionMode="Extended"
                                KeyboardNavigation.TabNavigation="Once"
                                AutomationProperties.Name="{Binding Title}"
                                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                VirtualizingPanel.ScrollUnit="Item" BorderThickness="0"
                                SelectionChanged="FileList_SelectionChanged" PreviewKeyDown="FileList_PreviewKeyDown"
                                MouseDoubleClick="FileList_MouseDoubleClick"
                                PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseMove="FileList_PreviewMouseMove">
                    <v:FileListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </v:FileListView.ItemContainerStyle>
                    <v:FileListView.View>
                        <GridView x:Name="ListColumns" AllowsColumnReorder="False" />
                    </v:FileListView.View>
                    <v:FileListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="v:AppCommands.OpenItem" />
                            <MenuItem Command="v:AppCommands.Preview" InputGestureText="Space" />
                            <MenuItem Command="v:AppCommands.GetInfo" />
                            <MenuItem Command="v:AppCommands.EditCaption" />
                            <MenuItem Command="v:AppCommands.ShowInExplorer" />
                            <Separator />
                            <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                            <MenuItem Command="v:AppCommands.Export" />
                            <Separator />
                            <MenuItem Command="v:AppCommands.ToggleFavorite" />
                            <MenuItem Command="v:AppCommands.DescribeImage" />
                        </ContextMenu>
                    </v:FileListView.ContextMenu>
                </v:FileListView>

                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Visibility="Collapsed" />

                <DockPanel x:Name="GalleryPanel" Visibility="Collapsed" PreviewKeyDown="Gallery_PreviewKeyDown">
                    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousButton" Content="◀ Previous" Padding="10,3" Click="PreviousButton_Click"
                                        AutomationProperties.Name="Previous" />
                                <TextBlock x:Name="GalleryPositionText" Margin="10,0" VerticalAlignment="Center" />
                                <Button x:Name="NextButton" Content="Next ▶" Padding="10,3" Click="NextButton_Click"
                                        AutomationProperties.Name="Next" />
                            </StackPanel>
                            <StackPanel>
                                <TextBox x:Name="GalleryName" FontWeight="SemiBold" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         AutomationProperties.Name="Name" IsTabStop="False" />
                                <TextBox x:Name="GalleryDetails" IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"
                                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" AutomationProperties.Name="Details" />
                                <TextBox x:Name="GalleryCaption" IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"
                                         TextWrapping="Wrap" AutomationProperties.Name="Caption" />
                                <TextBox x:Name="GalleryDescription" IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"
                                         TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Description" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- One focusable image with the same name the list uses, so a screen reader's image
                         description (JAWS Picture Smart, NVDA's describers) looks at the full-size picture. -->
                    <v:GalleryImage x:Name="GalleryImage" Margin="16" Focusable="True" FocusVisualStyle="{x:Null}"
                                    MouseDown="GalleryImage_MouseDown" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
