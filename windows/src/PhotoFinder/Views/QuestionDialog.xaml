<Window x:Class="PhotoFinder.Views.QuestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- A question with its own button names, where MessageBox's OK/Cancel would be vague. The details are also the
         default button's help text, so a screen reader says them with the button focus starts on. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="QuestionText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="DetailsText" Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="YesButton" IsDefault="True" MinWidth="90" Padding="10,3" Click="Yes_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
