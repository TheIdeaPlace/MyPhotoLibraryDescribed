<Window x:Class="PhotoFinder.Views.ColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Columns" Width="660" Height="580" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock x:Name="Explanation" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Choose which columns the list shows, and in what order. Each photo is read in this order too: put Caption or Date Taken first to hear it before the file name." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Padding="10,3" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Label Content="_Preview of the selected photo's line:" Target="{Binding ElementName=PreviewBox}" Padding="0,0,0,3" />
            <TextBox x:Name="PreviewBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MinHeight="44"
                     AutomationProperties.Name="Preview of the selected photo's line" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <!-- Always enabled, so the Tab order never changes: each says when there's nothing it can do. -->
            <Button Content="_Add" Padding="10,3" Margin="0,0,6,6" Click="Add_Click" />
            <Button Content="_Remove" Padding="10,3" Margin="0,0,6,6" Click="Remove_Click" />
            <Button Content="Move _Up" Padding="10,3" Margin="0,0,6,6" Click="MoveUp_Click" />
            <Button Content="Move _Down" Padding="10,3" Margin="0,0,6,6" Click="MoveDown_Click" />
            <Button Content="Move to _Top" Padding="10,3" Margin="0,0,6,6" Click="MoveTop_Click" />
            <Button Content="Move to _Bottom" Padding="10,3" Margin="0,0,6,6" Click="MoveBottom_Click" />
            <Button Content="R_eset to Default" Padding="10,3" Margin="0,0,6,6" Click="Reset_Click" />
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Label DockPanel.Dock="Top" Content="A_vailable columns:" Target="{Binding ElementName=AvailableList}" Padding="0,0,0,3" />
                <ListBox x:Name="AvailableList" AutomationProperties.Name="Available columns" MouseDoubleClick="AvailableList_MouseDoubleClick" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <Label DockPanel.Dock="Top" Content="_Shown columns, in the order they're read:" Target="{Binding ElementName=ShownList}" Padding="0,0,0,3" />
                <ListBox x:Name="ShownList" AutomationProperties.Name="Shown columns, in the order they're read"
                         MouseDoubleClick="ShownList_MouseDoubleClick" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
