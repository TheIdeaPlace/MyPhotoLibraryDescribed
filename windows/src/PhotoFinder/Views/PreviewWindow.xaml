<Window x:Class="PhotoFinder.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PhotoFinder.Views"
        Title="Preview" Width="1000" Height="760" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PlayButton" Content="_Pause" Padding="10,3" Margin="0,0,8,0" Click="PlayButton_Click" Visibility="Collapsed" />
                    <Button x:Name="PreviousButton" Content="◀ Previous" AutomationProperties.Name="Previous" Padding="10,3" Click="PreviousButton_Click" />
                    <TextBlock x:Name="PositionText" Margin="10,0" VerticalAlignment="Center" />
                    <Button x:Name="NextButton" Content="Next ▶" AutomationProperties.Name="Next" Padding="10,3" Click="NextButton_Click" />
                    <Button Content="Close" IsCancel="True" Padding="10,3" Margin="12,0,0,0" Click="Close_Click" />
                </StackPanel>
                <TextBlock x:Name="CaptionText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <Grid Background="Black">
            <v:GalleryImage x:Name="Picture" Margin="8" Focusable="True" FocusVisualStyle="{x:Null}" Foreground="White" />
            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed"
                          MediaEnded="Video_MediaEnded" MediaFailed="Video_MediaFailed" Focusable="False" />
        </Grid>
    </DockPanel>
</Window>
